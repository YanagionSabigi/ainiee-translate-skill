{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "material_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              null,
              "accept",
              "keep",
              "edit",
              "comment"
            ]
          },
          "edits": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "touched": {
            "type": "boolean"
          },
          "comment": {
            "type": "string"
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "block_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "version": {
                  "enum": [
                    "before",
                    "proposal",
                    "baseline",
                    "evidence"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "prefix": {
                  "type": "string"
                },
                "suffix": {
                  "type": "string"
                },
                "base_commit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40,64}$"
                }
              },
              "required": [
                "item_id",
                "block_id",
                "version",
                "text",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "shapes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "kind": {
                  "enum": [
                    "rectangle",
                    "ellipse",
                    "arrow"
                  ]
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "comment": {
                  "type": "string"
                }
              },
              "required": [
                "asset_id",
                "kind",
                "coordinates",
                "comment"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "base_commit",
    "material_hash",
    "revision",
    "items"
  ],
  "additionalProperties": false
}
