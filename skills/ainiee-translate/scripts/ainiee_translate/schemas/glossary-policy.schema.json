{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "person_name_mode": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "person_name_mode"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
