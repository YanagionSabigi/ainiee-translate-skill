# Ainiee lightweight interpreter: install -e '.[pdf]' for the optional PDF path.
AINIEE_MINERU_PYTHON=/path/to/mineru/.venv/bin/python
MINERU_HOME=/path/to/mineru
MINERU_CONFIG=/path/to/mineru/state/config.yaml
# Optional, for explicit BabelDOC or original Office fallback only.
# AINIEE_REPO=/path/to/AiNiee
# Optional project-specific locked-glossary schema; never a global personal rule.
# AINIEE_GLOSSARY_SCHEMA=/path/to/project/schemas/glossary.locked.schema.json
# Optional official EPUBCheck with a separately installed Java runtime.
# EPUBCHECK_JAR=/path/to/epubcheck/epubcheck.jar
# Optional book template tools (not needed for Markdown/EPUB).
# AINIEE_XELATEX=/path/to/xelatex
# AINIEE_TYPST=/path/to/typst
# AINIEE_PANDOC=/path/to/pandoc
# TYPST_FONT_PATHS=/path/to/locally-installed/fonts
